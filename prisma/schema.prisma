generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  cart
  checkout_started
  inventory_reserved
  payment_pending
  manual_payment_proof_submitted
  awaiting_admin_payment_approval
  payment_approved
  paid
  preparing
  ready_for_pickup
  ready_for_pickup_dispatch
  completed
  cancelled
  refunded
  partially_refunded
  payment_failed
  expired
}

enum PaymentProvider {
  stripe
  paypal
  manual
}

enum PaymentStatus {
  pending
  requires_action
  manual_proof_required
  manual_proof_submitted
  awaiting_admin_approval
  approved
  paid
  failed
  cancelled
  refunded
  partially_refunded
}

enum ProductStatus {
  draft
  active
  archived
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum InventoryAdjustmentType {
  initial
  increase
  decrease
  expire
  correction
  reservation
  release
}

enum UserType {
  admin
  customer
}

enum PromotionStatus {
  draft
  active
  archived
}

enum PromotionDiscountType {
  percentage
  fixed_amount
  bundle
  free_shipping
  first_order
}

enum PromotionTargetType {
  all_products
  products
  categories
  brands
  customers
}

enum LoyaltyLedgerType {
  earned
  redeemed
  adjusted
}

enum LoyaltyQuestGoalType {
  order_count
  spend_amount
  category_purchase
}

enum BundleTemplateStatus {
  draft
  active
  archived
}

enum SnackPlanStatus {
  draft
  generated
  converted
  archived
}

enum GroupCartStatus {
  open
  merged
  archived
}

model Tenant {
  id                            String   @id @default(uuid())
  name                          String
  slug                          String   @unique
  businessEmail                 String?
  businessPhone                 String?
  active                        Boolean  @default(true)
  delegatedRoleApprovalRequired Boolean  @default(true)
  manualPaymentEnabled          Boolean  @default(true)
  defaultCurrency               String   @default("USD")
  timezone                      String   @default("America/New_York")
  metadata                      Json     @default("{}")
  deactivatedAt                 DateTime?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  users                         UserRole[]
  products                      Product[]
  skus                          Sku[]
  orders                        Order[]
  payments                      Payment[]
  carts                         Cart[]
  manualPaymentMethods          ManualPaymentMethod[]
  promotions                    Promotion[]
  couponCodes                   CouponCode[]
  promotionRedemptions          PromotionRedemption[]
  loyaltyLedgerEntries          LoyaltyLedgerEntry[]
  loyaltyQuests                 LoyaltyQuest[]
  loyaltyQuestProgress          LoyaltyQuestProgress[]
  bundleTemplates               BundleTemplate[]
  snackPlans                    SnackPlan[]
  groupCarts                    GroupCart[]
  roleChangeApprovals           RoleChangeApproval[]
  newsletterSubscriptions       NewsletterSubscription[]

  @@index([active, slug])
  @@index([active, name])
}

model NewsletterSubscription {
  id             String    @id @default(uuid())
  tenantId       String
  email          String
  source         String    @default("storefront")
  status         String    @default("subscribed")
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  metadata       Json      @default("{}")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, subscribedAt])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?
  name         String
  userType     UserType   @default(admin)
  passwordHash String?
  adminMfaEnabled Boolean @default(false)
  adminMfaSecretHash String?
  adminMfaVerifiedAt DateTime?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  roles        UserRole[]
  sessions     Session[]
  targetRoleChangeApprovals    RoleChangeApproval[] @relation("RoleChangeTargetUser")
  requestedRoleChangeApprovals RoleChangeApproval[] @relation("RoleChangeRequestedBy")
  reviewedRoleChangeApprovals  RoleChangeApproval[] @relation("RoleChangeReviewedBy")
  carts        Cart[]
  orders       Order[]
  promotionRedemptions PromotionRedemption[]
  loyaltyLedgerEntries LoyaltyLedgerEntry[]
  loyaltyQuestProgress LoyaltyQuestProgress[]
  snackPlans SnackPlan[]
  ownedGroupCarts GroupCart[] @relation("GroupCartOwner")
  groupCartParticipants GroupCartParticipant[]

  @@index([userType, email])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Role {
  id          String           @id @default(uuid())
  name        String
  tenantId    String?
  permissions RolePermission[]
  users       UserRole[]
  roleChangeApprovals RoleChangeApproval[]
  @@unique([tenantId, name])
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserRole {
  id       String  @id @default(uuid())
  userId   String
  roleId   String
  tenantId String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  @@unique([userId, roleId, tenantId])
  @@index([tenantId])
  @@index([roleId])
}

model RoleChangeApproval {
  id            String         @id @default(uuid())
  tenantId      String
  targetUserId  String
  roleId        String
  action        String
  status        ApprovalStatus @default(pending)
  requestedById String
  reviewedById  String?
  reason        String?
  createdAt     DateTime       @default(now())
  reviewedAt    DateTime?
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetUser    User           @relation("RoleChangeTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  requestedBy   User           @relation("RoleChangeRequestedBy", fields: [requestedById], references: [id])
  reviewedBy    User?          @relation("RoleChangeReviewedBy", fields: [reviewedById], references: [id])

  @@index([tenantId, status])
  @@index([targetUserId])
  @@index([requestedById])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  brand       String?
  category    String?
  status      ProductStatus @default(draft)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  skus        Sku[]
  images      ProductImage[]
  bundleItemRules BundleItemRule[]
  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, category, status])
  @@index([tenantId, brand, status])
  @@index([tenantId, createdAt])
}

model Sku {
  id         String   @id @default(uuid())
  tenantId   String
  productId  String
  name       String
  priceCents Int
  currency   String   @default("USD")
  active     Boolean  @default(true)
  metadata   Json     @default("{}")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches    InventoryBatch[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  groupCartItems GroupCartItem[]
  @@index([tenantId, productId])
}

model ProductImage {
  id              String  @id @default(uuid())
  productId       String
  url             String
  objectKey       String?
  storageProvider String  @default("cloudinary")
  contentType     String?
  alt             String?
  sortOrder       Int     @default(0)
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryBatch {
  id          String   @id @default(uuid())
  tenantId    String
  skuId       String
  quantity    Int
  reserved    Int      @default(0)
  expiresAt   DateTime?
  expiredAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sku         Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]
  adjustments InventoryAdjustment[]

  @@index([tenantId, skuId])
  @@index([tenantId, expiresAt])
  @@index([tenantId, expiredAt])
}

model InventoryAdjustment {
  id        String                  @id @default(uuid())
  batchId   String
  tenantId  String
  skuId     String
  actorId   String?
  type      InventoryAdjustmentType
  quantityDelta Int
  reason    String
  createdAt DateTime                @default(now())
  batch     InventoryBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, skuId])
  @@index([batchId, createdAt])
}

model InventoryReservation {
  id        String         @id @default(uuid())
  tenantId  String
  batchId   String
  orderId   String?
  quantity  Int
  expiresAt DateTime
  committed Boolean        @default(false)
  releasedAt DateTime?
  createdAt DateTime       @default(now())
  batch     InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  order     Order?         @relation(fields: [orderId], references: [id])

  @@index([tenantId, expiresAt])
  @@index([tenantId, orderId])
  @@index([orderId, committed])
  @@index([batchId])
}

model Cart {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String?
  sessionId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@index([tenantId, sessionId])
  @@index([tenantId, userId])
}

model CartItem {
  id       String @id @default(uuid())
  cartId   String
  skuId    String
  quantity Int
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku      Sku    @relation(fields: [skuId], references: [id])

  @@unique([cartId, skuId])
  @@index([skuId])
}

model Order {
  id          String       @id @default(uuid())
  tenantId    String
  userId      String?
  status      OrderStatus  @default(checkout_started)
  totalCents  Int
  subtotalCents Int      @default(0)
  discountCents Int      @default(0)
  currency    String       @default("USD")
  customer    Json
  promotionSnapshot Json  @default("{}")
  reservationExpiresAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  history     OrderStatusHistory[]
  reservations InventoryReservation[]
  promotionRedemptions PromotionRedemption[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, userId, status])
  @@index([tenantId, reservationExpiresAt])
  @@index([tenantId, status, reservationExpiresAt])
  @@index([reservationExpiresAt])
}

model OrderItem {
  id              String @id @default(uuid())
  orderId          String
  skuId            String?
  productName      String
  skuName          String
  unitPriceCents   Int
  quantity         Int
  lineTotalCents   Int
  snapshot         Json
  order            Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku              Sku?   @relation(fields: [skuId], references: [id])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  actorId   String?
  reason    String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String          @id @default(uuid())
  tenantId      String
  orderId       String
  provider      PaymentProvider
  status        PaymentStatus   @default(pending)
  amountCents   Int
  currency      String          @default("USD")
  providerRef   String?
  reconciliationStatus String  @default("pending")
  reconciledAt  DateTime?
  lastProviderEventId String?
  metadata      Json            @default("{}")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  manualProofs  ManualPaymentProof[]
  providerEvents PaymentProviderEvent[]

  @@index([tenantId, status])
  @@index([orderId, provider])
  @@index([provider, providerRef])
  @@index([tenantId, reconciliationStatus])
}

model PaymentProviderEvent {
  id          String          @id @default(uuid())
  provider    PaymentProvider
  eventId     String
  eventType   String
  tenantId    String?
  paymentId   String?
  orderId     String?
  status      String          @default("received")
  payload     Json            @default("{}")
  error       String?
  processedAt DateTime?
  createdAt   DateTime        @default(now())
  payment      Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([provider, status, createdAt])
  @@index([tenantId, createdAt])
  @@index([paymentId])
  @@index([orderId])
}

model ManualPaymentMethod {
  id           String   @id @default(uuid())
  tenantId     String
  key          String
  label        String
  instructions String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proofs       ManualPaymentProof[]

  @@unique([tenantId, key])
  @@index([tenantId, active])
}

model ManualPaymentProof {
  id                    String   @id @default(uuid())
  paymentId             String
  manualPaymentMethodId String
  receiptUrl            String
  objectKey             String?
  storageProvider       String?
  contentType           String?
  note                  String?
  rejectionReason       String?
  reviewedAt            DateTime?
  reviewedBy            String?
  createdAt             DateTime @default(now())
  payment               Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  manualPaymentMethod   ManualPaymentMethod @relation(fields: [manualPaymentMethodId], references: [id])

  @@index([manualPaymentMethodId])
  @@index([reviewedAt])
}

model Promotion {
  id                    String                @id @default(uuid())
  tenantId              String
  name                  String
  description           String?
  status                PromotionStatus       @default(draft)
  discountType          PromotionDiscountType
  discountValue         Int                   @default(0)
  targetType            PromotionTargetType   @default(all_products)
  targetProductIds      String[]              @default([])
  targetCategories      String[]              @default([])
  targetBrands          String[]              @default([])
  targetCustomerIds     String[]              @default([])
  startsAt              DateTime?
  endsAt                DateTime?
  usageLimit            Int?
  perCustomerLimit      Int?
  minimumOrderAmountCents Int?
  stackable             Boolean               @default(false)
  metadata              Json                  @default("{}")
  archivedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coupons               CouponCode[]
  redemptions           PromotionRedemption[]

  @@index([tenantId, status])
  @@index([tenantId, startsAt, endsAt])
  @@index([tenantId, discountType])
}

model CouponCode {
  id           String    @id @default(uuid())
  tenantId     String
  promotionId  String
  code         String
  active       Boolean   @default(true)
  usageLimit   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  redemptions  PromotionRedemption[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@index([promotionId])
}

model PromotionRedemption {
  id            String    @id @default(uuid())
  tenantId      String
  promotionId   String
  couponCodeId  String?
  orderId       String?
  userId        String?
  customerEmail String?
  discountCents Int
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion     Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  couponCode    CouponCode? @relation(fields: [couponCodeId], references: [id], onDelete: SetNull)
  order         Order?    @relation(fields: [orderId], references: [id])
  user          User?     @relation(fields: [userId], references: [id])

  @@index([tenantId, promotionId])
  @@index([tenantId, couponCodeId])
  @@index([tenantId, customerEmail])
  @@index([tenantId, orderId])
  @@index([userId])
}

model LoyaltyLedgerEntry {
  id        String            @id @default(uuid())
  tenantId  String
  userId    String
  points    Int
  type      LoyaltyLedgerType
  reason    String
  metadata  Json              @default("{}")
  createdAt DateTime          @default(now())
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, type])
}

model LoyaltyQuest {
  id           String               @id @default(uuid())
  tenantId     String
  name         String
  description  String?
  goalType     LoyaltyQuestGoalType
  goalTarget   Int
  rewardPoints Int
  active       Boolean              @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  metadata     Json                 @default("{}")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  progress     LoyaltyQuestProgress[]

  @@index([tenantId, active])
  @@index([tenantId, startsAt, endsAt])
}

model LoyaltyQuestProgress {
  id              String       @id @default(uuid())
  tenantId        String
  questId         String
  userId          String
  progress        Int          @default(0)
  completedAt     DateTime?
  rewardClaimedAt DateTime?
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quest           LoyaltyQuest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questId, userId])
  @@index([tenantId, userId])
}

model BundleTemplate {
  id                String               @id @default(uuid())
  tenantId          String
  name              String
  description       String?
  status            BundleTemplateStatus @default(draft)
  budgetTargetCents Int?
  minItems          Int                  @default(2)
  maxItems          Int                  @default(5)
  preferredCategories String[]           @default([])
  preferredTags     String[]             @default([])
  metadata          Json                 @default("{}")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules             BundleItemRule[]

  @@index([tenantId, status])
}

model BundleItemRule {
  id         String         @id @default(uuid())
  templateId String
  productId  String?
  category   String?
  minQuantity Int          @default(1)
  maxQuantity Int          @default(1)
  metadata    Json         @default("{}")
  template    BundleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product     Product?       @relation(fields: [productId], references: [id])

  @@index([templateId])
  @@index([productId])
}

model SnackPlan {
  id                  String          @id @default(uuid())
  tenantId            String
  userId              String?
  name                String
  participantCount    Int
  budgetTargetCents   Int
  preferredCategories String[]        @default([])
  preferredTags       String[]        @default([])
  status              SnackPlanStatus @default(draft)
  suggestion          Json            @default("{}")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?           @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, status])
}

model GroupCart {
  id          String            @id @default(uuid())
  tenantId    String
  ownerUserId String?
  cartId      String?
  name        String
  shareToken  String            @unique
  status      GroupCartStatus   @default(open)
  expiresAt   DateTime?
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner       User?             @relation("GroupCartOwner", fields: [ownerUserId], references: [id])
  participants GroupCartParticipant[]
  items       GroupCartItem[]

  @@index([tenantId, ownerUserId])
  @@index([tenantId, status])
}

model GroupCartParticipant {
  id          String       @id @default(uuid())
  groupCartId String
  userId      String?
  name        String
  email       String?
  createdAt   DateTime     @default(now())
  groupCart   GroupCart    @relation(fields: [groupCartId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])
  items       GroupCartItem[]

  @@index([groupCartId])
  @@index([userId])
}

model GroupCartItem {
  id            String      @id @default(uuid())
  groupCartId   String
  participantId String?
  skuId         String
  quantity      Int
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  groupCart     GroupCart   @relation(fields: [groupCartId], references: [id], onDelete: Cascade)
  participant   GroupCartParticipant? @relation(fields: [participantId], references: [id])
  sku           Sku         @relation(fields: [skuId], references: [id])

  @@index([groupCartId])
  @@index([skuId])
}

model Notification {
  id        String    @id @default(uuid())
  tenantId  String?
  userId    String?
  channel   String
  templateKey String?
  recipient String?
  deliveryKey String?
  subject   String?
  body      String
  status    String    @default("pending")
  attempts  Int       @default(0)
  processingAt DateTime?
  sentAt    DateTime?
  failedAt  DateTime?
  lastError String?
  nextAttemptAt DateTime?
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, templateKey])
  @@index([deliveryKey])
  @@unique([deliveryKey])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  actorId   String?
  action    String
  target    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
}

model OutboxEvent {
  id          String    @id @default(uuid())
  name        String
  tenantId    String?
  aggregateId String
  payload     Json
  processedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
  @@index([tenantId, processedAt])
  @@index([name, processedAt])
}

model IdempotencyRecord {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  scope     String
  response  Json?
  createdAt DateTime @default(now())

  @@unique([tenantId, key, scope])
  @@index([tenantId, createdAt])
}

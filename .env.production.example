NODE_ENV=production
HOST=0.0.0.0
PORT=4000

# Browser origins allowed to call the API. Use comma-separated origins if needed.
APP_CORS_ORIGIN=https://your-web.vercel.app

# Auth and cookies
AUTH_ACCESS_TOKEN_SECRET=replace-with-long-random-secret
AUTH_REFRESH_TOKEN_SECRET=replace-with-long-random-secret
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=true
MFA_ISSUER=TeahTreats
MFA_SECRET_ENCRYPTION_KEY=replace-with-32-byte-encryption-key

# Data and infrastructure
DATABASE_URL=postgresql://user:password@host:5432/snacks_commerce?schema=public
REDIS_URL=redis://default:password@host:6379
OPENSEARCH_NODE=https://your-opensearch-host
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@your-domain.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=production
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Backup notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Web build/runtime
NEXT_PUBLIC_API_BASE_URL=https://your-api-domain/api/v1
NEXT_PUBLIC_TEMP_TENANT_ID=platform

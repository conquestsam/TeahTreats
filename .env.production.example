# =============================================================================
# TeshTreats Production Environment
# =============================================================================
# Copy this file to `.env.production` on the Contabo server.
#
# Important:
# - Docker services talk to each other with Compose service names such as
#   `postgres`, `redis`, and `opensearch`.
# - Do not use the Contabo public IP inside DATABASE_URL, REDIS_URL, or
#   OPENSEARCH_NODE when the services run in this docker-compose stack.
# - The public IP or API domain is only for browsers, Vercel, DNS, and SSH.
# =============================================================================

# =============================================================================
# API Runtime - Docker container on Contabo
# =============================================================================
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
API_PUBLIC_PORT=4000

# Browser origins allowed to call the API. Use comma-separated origins.
# Use the Vercel URL first, then add your custom storefront/admin domain.
APP_CORS_ORIGIN=https://your-web.vercel.app,https://teshtreats.com

# Used by customer OAuth redirects and API-generated links back to the web app.
WEB_APP_URL=https://your-web.vercel.app

# =============================================================================
# Auth, Cookies, and MFA
# =============================================================================
AUTH_ACCESS_TOKEN_SECRET=replace-with-long-random-secret
AUTH_REFRESH_TOKEN_SECRET=replace-with-long-random-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d

# Leave blank when testing with raw IP addresses.
# Set to `.teshtreats.com` only after both web and API are on HTTPS subdomains.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=true
MFA_ISSUER=TeshTreats
MFA_SECRET_ENCRYPTION_KEY=replace-with-32-byte-encryption-key

# =============================================================================
# Docker Compose Service Passwords
# =============================================================================
# Used by docker-compose.prod.yml to provision internal services.
POSTGRES_USER=snacks
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_PASSWORD_URLENCODED=replace-with-url-encoded-postgres-password
POSTGRES_DB=snacks_commerce
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_PASSWORD_URLENCODED=replace-with-url-encoded-redis-password
OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-strong-opensearch-password
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# =============================================================================
# Data and Infrastructure - Internal Docker network
# =============================================================================
# These values are also supplied by docker-compose.prod.yml for api/worker.
# Keep them here for CLI commands run on the server, such as migrations.
DATABASE_URL=postgresql://snacks:replace-with-url-encoded-postgres-password@postgres:5432/snacks_commerce?schema=public
REDIS_URL=redis://default:replace-with-url-encoded-redis-password@redis:6379

# OpenSearch is currently required by the API env schema.
# Keep this internal URL when using the bundled opensearch service.
OPENSEARCH_NODE=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# =============================================================================
# Media Storage
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# =============================================================================
# Notifications - Email, SMS, and WhatsApp
# =============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@teshtreats.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# =============================================================================
# Payments
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=production
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# =============================================================================
# Backup Notifications
# =============================================================================
# Used by the daily DB backup workflow/script to notify the team.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# =============================================================================
# Vercel Frontend Runtime
# =============================================================================
# Set these in Vercel project environment variables.
# If DNS is not ready yet, temporarily use:
NEXT_PUBLIC_API_BASE_URL=https://api.teshtreats.com/api/v1
NEXT_PUBLIC_TEMP_TENANT_ID=platform

# =============================================================================
# GitHub Actions / CI-CD Secrets - do not place these in the server env file
# =============================================================================
# SSH_HOST=62.169.16.51
# SSH_USER=<contabo-ssh-user>
# SSH_PRIVATE_KEY=<github-secret-only>
# SERVER_APP_DIR=/opt/teshtreats
# VERCEL_TOKEN=<github-secret-only>
# VERCEL_ORG_ID=<github-secret-only>
# VERCEL_PROJECT_ID=<github-secret-only>
